<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件底板：圆角 + 一圈跟主题走的描边。
     描边不是装饰：桌面壁纸什么颜色都有，没有这一圈的话，
     浅色壁纸上的浅色组件会「糊」进背景里，边界看不出来。

     Android 12 起系统会给桌面小组件套一层自己的圆角遮罩，
     自己再画一个不同半径的圆角就成了「双层圆角」（外一层内一层），
     所以 v31 那份直接用系统半径。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_line" />
</shape>
