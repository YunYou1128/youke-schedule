<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 内嵌教务浏览器顶部 / 底部工具栏上的小按钮 -->
    <style name="EduToolBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:minWidth">50dp</item>
        <item name="android:background">@drawable/bg_edu_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/edu_ink</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="EduPrimaryBtn" parent="EduToolBtn">
        <item name="android:layout_height">38dp</item>
        <item name="android:minWidth">104dp</item>
        <item name="android:background">@drawable/bg_edu_primary</item>
        <item name="android:textColor">@color/edu_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
