<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 今明日课程。

     minWidth 250dp（70dp × 4 − 30dp）、minHeight 110dp（2 格），
     Android 12 起改用 targetCellWidth / targetCellHeight 直接按格子数指定。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_twoday"
    android:previewLayout="@layout/widget_twoday"
    android:label="@string/widget_twoday_label"
    android:description="@string/widget_twoday_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
